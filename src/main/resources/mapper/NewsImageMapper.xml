<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.guat.mynewsapp.mapper.NewsImageMapper">
<!--通用结果映射-->
    <resultMap id="BaseResultMap" type="com.guat.mynewsapp.entity.NewsImage">
        <id column="id" property="id"/>
        <result column="news_id" property="newsId"/>
        <result column="image_url" property="imageUrl"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="create_time" property="createTime"/>
        <result column="media_type" property="mediaId"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="width" property="width"/>
        <result column="height" property="height"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 批量插入图片 缺少插入创建时间-->
    <insert id="batchInsert">
        INSERT INTO news_image (news_id, image_url, sort_order, media_type)
        VALUES
        <foreach collection="images" item="img" separator=",">
            (#{img.newsId}, #{img.imageUrl}, #{img.sortOrder}, #{img.mediaId})
        </foreach>
    </insert>

    <!-- 根据新闻ID查图片 -->
    <select id="selectByNewsId" resultMap="BaseResultMap">
        SELECT * FROM news_image WHERE news_id = #{newsId} AND (is_delete IS NULL OR is_delete = 0) ORDER BY sort_order ASC
    </select>

    <!-- 批量删除图片（按ID） -->
    <delete id="deleteByIds">
        DELETE FROM news_image WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 按新闻ID删除图片 -->
    <delete id="deleteByNewsId">
        DELETE FROM news_image WHERE news_id = #{newsId}
    </delete>

    <!-- 逻辑删除图片（按ID集合，标记 is_deleted 为 1，保留数据与文件） -->
    <update id="logicalDeleteByIds">
        UPDATE news_image SET is_delete = 1
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
    <!-- 按图片ID更新（拖拽排序/修改图片信息） -->
    <update id="updateById">
        UPDATE news_image
        <set>
            <if test="newsId != null">news_id = #{newsId},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="mediaId != null">media_type = #{mediaId},</if>
            <if test="coverUrl != null">cover_url = #{coverUrl},</if>
            <if test="width != null">width = #{width},</if>
            <if test="height != null">height = #{height},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>